project              = "appsorter"
aws_region           = "ap-northeast-1"
bedrock_model_id     = "jp.anthropic.claude-haiku-4-5-20251001-v1:0"
stage_name           = "v1"
throttle_rate_limit  = 10
throttle_burst_limit = 20
max_apps_per_request = 50

# 1 Cognito identity あたりの上限
daily_limit_per_identity   = 10
monthly_limit_per_identity = 100

# 月額コスト上限（USD）。100%超でDynamoDB kill switch発火
budget_limit_usd   = 10
notification_email = "your-email@example.com"

# 他スタックで既にAPI Gateway のアカウント共通ロールを作っているなら false
manage_apigw_account = true
